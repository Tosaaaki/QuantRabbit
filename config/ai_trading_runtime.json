{
  "version": 1,
  "state_root": "~/.codex/state/quantrabbit/ai-trader",
  "profiles": {
    "intraday": {
      "kind": "trade",
      "cadence_minutes": 10,
      "decision_max_age_seconds": 900,
      "sink": "live_gateway",
      "workers": {
        "broker": [
          {"path": "data/broker_snapshot.json", "required": true, "max_age_seconds": 900}
        ],
        "market": [
          {"path": "data/pair_charts.json", "required": true, "max_age_seconds": 900},
          {"path": "data/market_context_matrix.json", "required": true, "max_age_seconds": 900},
          {"path": "data/order_intents.json", "required": false, "max_age_seconds": 3600}
        ],
        "news": [
          {"path": "data/news_health.json", "required": true, "max_age_seconds": 1800},
          {"path": "data/news_snapshot.json", "required": false, "max_age_seconds": 7200}
        ],
        "strategy": [
          {"path": "@state/strategic_review.json", "required": false, "max_age_seconds": 10800}
        ]
      }
    },
    "strategic": {
      "kind": "review",
      "cadence_minutes": 120,
      "decision_max_age_seconds": 3600,
      "sink": "review_overlay",
      "workers": {
        "performance": [
          {"path": "docs/execution_ledger_report.md", "required": true, "max_age_seconds": 21600},
          {"path": "data/profitability_acceptance.json", "required": false, "max_age_seconds": 21600},
          {"path": "data/verification_ledger.json", "required": false, "max_age_seconds": 21600}
        ],
        "regime": [
          {"path": "data/hierarchical_bot_regime.json", "required": true, "max_age_seconds": 10800},
          {"path": "data/market_context_matrix.json", "required": true, "max_age_seconds": 3600}
        ],
        "risk": [
          {"path": "data/broker_snapshot.json", "required": true, "max_age_seconds": 1800},
          {"path": "data/guardian_events.json", "required": false, "max_age_seconds": 3600}
        ]
      }
    }
  }
}
