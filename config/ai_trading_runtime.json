{
  "version": 2,
  "state_root": "~/.codex/state/quantrabbit/ai-trader",
  "legacy_strategy_authority": "BASELINE_ONLY",
  "profiles": {
    "intraday": {
      "kind": "trade",
      "cadence_minutes": 10,
      "decision_max_age_seconds": 900,
      "sink": "live_gateway",
      "allowed_actions": ["ENTER", "WAIT", "REQUEST_EVIDENCE"],
      "workers": {
        "policy": [
          {"path": "@state/policy_snapshot.json", "required": true, "max_age_seconds": 21600}
        ],
        "evidence": [
          {"path": "@state/evidence_packet.json", "required": true, "max_age_seconds": 900}
        ],
        "strategy": [
          {"path": "@state/strategic_review.json", "required": false, "max_age_seconds": 10800}
        ]
      }
    },
    "strategic": {
      "kind": "review",
      "cadence_minutes": 120,
      "decision_max_age_seconds": 3600,
      "sink": "review_overlay",
      "workers": {
        "evidence": [
          {"path": "@state/evidence_packet.json", "required": true, "max_age_seconds": 1800}
        ],
        "performance": [
          {"path": "data/capture_economics.json", "required": true, "max_age_seconds": 21600},
          {"path": "data/execution_timing_audit.json", "required": true, "max_age_seconds": 21600},
          {"path": "data/profitability_acceptance.json", "required": false, "max_age_seconds": 21600},
          {"path": "data/verification_ledger.json", "required": false, "max_age_seconds": 21600}
        ],
        "risk": [
          {"path": "data/broker_snapshot.json", "required": true, "max_age_seconds": 1800},
          {"path": "data/daily_target_state.json", "required": true, "max_age_seconds": 1800}
        ]
      }
    }
  }
}
