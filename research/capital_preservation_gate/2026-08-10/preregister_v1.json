  "scope": "research-only dry-run on the frozen 251 decision-time evidence rows",
  "permissions": {
    "holdout_read": false,
    "live": false,
    "paper": false,
    "broker_mutation": false,
    "order": false,
    "deploy": false
  },
  "frozen_sources": {
