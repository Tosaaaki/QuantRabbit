    "financial_oracle": "research/decision_time_execution_evidence/2026-08-10/financial_oracle_v1.json"
  },
  "decision_time_required_stages": [
    "pricing",
    "candidate_order",
    "fillability",
    "slippage_fee_financing",
    "margin_exposure_concurrency",
    "exit_unwind"
  ],
  "policy": {
