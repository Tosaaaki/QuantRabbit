    "prior_closed_loss_may_reduce_daily_budget": true,
    "later_profit_may_refill_daily_loss_budget": false,
    "missing_values_are_zero": false
  },
  "acceptance_tests": [
    "missing margin, costs, or unwind can never produce TRADE",
    "a fully evidenced positive-LCB bounded-risk shape can produce TRADE",
    "daily gross-loss spend is not refilled by profits",
    "drawdown lock blocks new exposure",
