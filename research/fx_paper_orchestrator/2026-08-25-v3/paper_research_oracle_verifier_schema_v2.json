{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantrabbit:paper-research-oracle-verifier:v2",
  "title": "QuantRabbit independent JPY oracle V2 verifier request",
  "$comment": "Artifact descriptors bind inert local content; they are not execution attestation. The sealed production verifier accepts only canonical request bytes, exact sorted immutable artifact and Oracle-release byte tuples, a canonical reference-result snapshot, and an exact sorted reference hash-attestation tuple. It accepts no callable, executable module, file descriptor, live path/filesystem access, output handle, rename callback, or publisher capability. Referenced JSON is decoded with strict authority types and recursive producer profit/outcome rejection. Verification remains local-unanchored accounting-only and non-admissible.",
  "x-sealed-production-interface": {
    "entrypoint": "verify_sealed_bytes",
    "arguments": [
      "request_bytes",
      "artifact_blobs",
      "oracle_release_blobs",
      "reference_result_bytes",
      "reference_attestation"
    ],
    "artifact_blob_roles_sorted": [
      "accounting_policy",
      "authority_policy",
      "evaluation_policy",
      "execution_policy",
      "instrument_registry",
      "inventory_policy",
      "oracle_code_snapshot",
      "oracle_commit",
      "oracle_contract_snapshot",
      "oracle_intent",
      "oracle_ledger",
      "oracle_manifest",
      "oracle_request",
      "oracle_schema_snapshot",
      "proposal",
      "reference_code_snapshot",
      "reference_contract_snapshot",
      "source_blob",
      "source_manifest"
    ],
    "oracle_release_roles_sorted": ["code_bytes", "contract_bytes", "schema_bytes"],
    "reference_attestation_keys_sorted": [
      "reference_code_sha256",
      "reference_contract_sha256",
      "reference_result_sha256"
    ],
    "returns": ["canonical_receipt_bytes", "canonical_commit_bytes"]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_blob",
    "source_manifest",
    "proposal",
    "execution_policy",
    "inventory_policy",
    "accounting_policy",
    "evaluation_policy",
    "instrument_registry",
    "authority_policy",
    "oracle_request",
    "oracle_code_snapshot",
    "oracle_contract_snapshot",
    "oracle_schema_snapshot",
    "reference_code_snapshot",
    "reference_contract_snapshot",
    "oracle_intent",
    "oracle_commit",
    "oracle_ledger",
    "oracle_manifest",
    "output_directory"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "source_blob": {"$ref": "#/$defs/source_blob_artifact"},
    "source_manifest": {"$ref": "#/$defs/source_manifest_artifact"},
    "proposal": {"$ref": "#/$defs/proposal_artifact"},
    "execution_policy": {"$ref": "#/$defs/execution_policy_artifact"},
    "inventory_policy": {"$ref": "#/$defs/inventory_policy_artifact"},
    "accounting_policy": {"$ref": "#/$defs/accounting_policy_artifact"},
    "evaluation_policy": {"$ref": "#/$defs/evaluation_policy_artifact"},
    "instrument_registry": {"$ref": "#/$defs/instrument_registry_artifact"},
    "authority_policy": {"$ref": "#/$defs/authority_policy_artifact"},
    "oracle_request": {"$ref": "#/$defs/oracle_request_artifact"},
    "oracle_code_snapshot": {"$ref": "#/$defs/oracle_code_snapshot_artifact"},
    "oracle_contract_snapshot": {"$ref": "#/$defs/oracle_contract_snapshot_artifact"},
    "oracle_schema_snapshot": {"$ref": "#/$defs/oracle_schema_snapshot_artifact"},
    "reference_code_snapshot": {"$ref": "#/$defs/reference_code_snapshot_artifact"},
    "reference_contract_snapshot": {"$ref": "#/$defs/reference_contract_snapshot_artifact"},
    "oracle_intent": {"$ref": "#/$defs/oracle_intent_artifact"},
    "oracle_commit": {"$ref": "#/$defs/oracle_commit_artifact"},
    "oracle_ledger": {"$ref": "#/$defs/oracle_ledger_artifact"},
    "oracle_manifest": {"$ref": "#/$defs/oracle_manifest_artifact"},
    "output_directory": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "relative_path": {"type": "string", "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(?:/[A-Za-z0-9][A-Za-z0-9_.-]{0,127})*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 2147483648}
      }
    },
    "json_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"properties": {"size_bytes": {"maximum": 33554432}}}
      ]
    },
    "source_blob_artifact": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"artifact_id": {"const": "source_blob"}}}]},
    "source_manifest_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "source_manifest"}}}]},
    "proposal_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "proposal"}}}], "$comment": "Referenced proposal content must be ex-ante only; identifier, fill, path, MFE/MAE, PnL, cost, equity, DD/CVaR, profit, and return fields are recursively forbidden."},
    "execution_policy_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "execution_policy"}}}]},
    "inventory_policy_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "inventory_policy"}}}]},
    "accounting_policy_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "accounting_policy"}}}]},
    "evaluation_policy_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "evaluation_policy"}}}]},
    "instrument_registry_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "instrument_registry"}}}]},
    "authority_policy_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "authority_policy"}}}], "$comment": "Referenced authority content requires exact JSON booleans for authority flags and exact integer zero, not boolean false, for external_orders."},
    "oracle_request_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_request"}}}]},
    "oracle_code_snapshot_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_code_snapshot"}}}]},
    "oracle_contract_snapshot_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_contract_snapshot"}}}]},
    "oracle_schema_snapshot_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_schema_snapshot"}}}]},
    "reference_code_snapshot_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "reference_code_snapshot"}}}], "$comment": "Exact inert content bytes must match the pinned EVENT_SOURCED_DOUBLE_ENTRY_REFERENCE_V1 code hash; the verifier never imports, compiles, or calls them."},
    "reference_contract_snapshot_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "reference_contract_snapshot"}}}], "$comment": "Exact inert content bytes must match the pinned supplemental double-entry reference contract hash."},
    "oracle_intent_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_intent"}}}]},
    "oracle_commit_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_commit"}}}]},
    "oracle_ledger_artifact": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"artifact_id": {"const": "oracle_ledger"}}}]},
    "oracle_manifest_artifact": {"allOf": [{"$ref": "#/$defs/json_artifact"}, {"properties": {"artifact_id": {"const": "oracle_manifest"}}}]},
    "reference_result_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "input_root_sha256",
        "ledger_bytes_base64",
        "ledger_row_count",
        "ledger_terminal_hash",
        "oracle_metrics",
        "proposal_provenance_root_sha256",
        "journal_root_sha256",
        "journal_transaction_count",
        "all_transactions_balanced",
        "economic_projection_sha256"
      ],
      "properties": {
        "engine_id": {"const": "EVENT_SOURCED_DOUBLE_ENTRY_REFERENCE_V1"},
        "input_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ledger_bytes_base64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
        "ledger_row_count": {"type": "integer", "minimum": 0},
        "ledger_terminal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "oracle_metrics": {"type": "object"},
        "proposal_provenance_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "journal_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "journal_transaction_count": {"type": "integer", "minimum": 0},
        "all_transactions_balanced": {"const": true},
        "economic_projection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "verifier_receipt": {
      "$comment": "Exact canonical output schema. Nested reference metrics are additionally validated against the frozen double-entry contract, the reference ledger, and the evaluation policy by the pure verifier before this object is emitted.",
      "additionalProperties": false,
      "properties": {
        "admission_eligible": {"const": false},
        "anchor_status": {"const": "LOCAL_UNANCHORED"},
        "authority": {
          "additionalProperties": false,
          "properties": {
            "broker_account_access": {"const": false},
            "credential_access": {"const": false},
            "deploy": {"const": false},
            "external_config_mutation": {"const": false},
            "external_orders": {"const": 0},
            "live_authority": {"const": false},
            "order_endpoint": {"const": false},
            "paper_only": {"const": true}
          },
          "required": [
            "paper_only", "live_authority", "broker_account_access",
            "credential_access", "order_endpoint", "external_orders",
            "deploy", "external_config_mutation"
          ],
          "type": "object"
        },
        "causal_signal_admission": {"const": false},
        "classification": {"const": "FUTURE_ONLY_ACCOUNTING_ONLY_LOCAL_UNANCHORED_NOT_ADMISSIBLE"},
        "detector_replay_receipt_required": {"const": true},
        "expected_canonical_ledger_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "external_orders": {"const": 0},
        "independently_rebuilt_ledger": {"const": true},
        "independently_rebuilt_metrics": {"const": true},
        "input_artifact_sha256": {
          "additionalProperties": false,
          "properties": {
            "accounting_policy": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "authority_policy": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "evaluation_policy": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "execution_policy": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "instrument_registry": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "inventory_policy": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_code_snapshot": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_commit": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_contract_snapshot": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_intent": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_ledger": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_manifest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_request": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "oracle_schema_snapshot": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "proposal": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "reference_code_snapshot": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "reference_contract_snapshot": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "source_blob": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "source_manifest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
          },
          "required": [
            "accounting_policy", "authority_policy", "evaluation_policy",
            "execution_policy", "instrument_registry", "inventory_policy",
            "oracle_code_snapshot", "oracle_commit", "oracle_contract_snapshot",
            "oracle_intent", "oracle_ledger", "oracle_manifest",
            "oracle_request", "oracle_schema_snapshot", "proposal",
            "reference_code_snapshot", "reference_contract_snapshot",
            "source_blob", "source_manifest"
          ],
          "type": "object"
        },
        "oracle_execution_provenance_scope": {"const": "LOCAL_CALLER_ASSERTED_CONTENT_BINDING_NOT_EXECUTION_ATTESTATION_NOT_EXTERNALLY_ANCHORED"},
        "oracle_ledger_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "oracle_ledger_size_bytes": {"minimum": 0, "type": "integer"},
        "oracle_ledger_terminal_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "oracle_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "oracle_manifest_size_bytes": {"minimum": 0, "type": "integer"},
        "oracle_release_content_binding": {
          "additionalProperties": false,
          "properties": {
            "code_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "contract_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "launcher_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "schema_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "snapshot_mode": {"const": "SEALED_FD_COMPILE_EXEC_V2"}
          },
          "required": ["code_sha256", "contract_sha256", "schema_sha256", "launcher_sha256", "snapshot_mode"],
          "type": "object"
        },
        "oracle_request_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "oracle_root_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "producer_result_or_metrics_used": {"const": false},
        "raw_source_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reference_accounting_diagnostics_only": {"const": true},
        "reference_all_transactions_balanced": {"const": true},
        "reference_code_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reference_contract_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reference_direction_accuracy_profit_gate_allowed": {"const": false},
        "reference_economic_projection_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reference_engine_id": {"const": "EVENT_SOURCED_DOUBLE_ENTRY_REFERENCE_V1"},
        "reference_input_root_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reference_journal_root_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "reference_journal_transaction_count": {"minimum": 0, "type": "integer"},
        "reference_n_eff_statistical_admission_allowed": {"const": false},
        "reference_result_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "release_evidence_eligible": {"const": false},
        "schema_version": {"const": 2},
        "status": {"const": "VERIFIED_ACCOUNTING_ONLY"},
        "terminal_inventory_mtm_jpy_micros": {"const": 0},
        "verified_oracle_metrics": {"type": "object"},
        "verifier_execution_provenance_scope": {"const": "LOCAL_CALLER_ASSERTED_CONTENT_BINDING_NOT_EXECUTION_ATTESTATION_NOT_EXTERNALLY_ANCHORED"},
        "verifier_implementation": {"const": "INDEPENDENT_JPY_ORACLE_VERIFIER_V2"},
        "verifier_receipt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "verifier_release_content_binding": {
          "additionalProperties": false,
          "properties": {
            "code_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "launcher_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "reference_code_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "reference_contract_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "reference_result_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "schema_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "snapshot_mode": {"const": "SEALED_FD_COMPILE_EXEC_V2"}
          },
          "required": [
            "code_sha256", "schema_sha256", "launcher_sha256",
            "reference_code_sha256", "reference_contract_sha256",
            "reference_result_sha256", "snapshot_mode"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema_version", "verifier_implementation", "status", "classification",
        "causal_signal_admission", "release_evidence_eligible", "admission_eligible",
        "detector_replay_receipt_required", "authority", "oracle_root_sha256",
        "oracle_manifest_sha256", "oracle_manifest_size_bytes", "oracle_ledger_sha256",
        "oracle_ledger_size_bytes", "expected_canonical_ledger_sha256",
        "oracle_ledger_terminal_hash", "raw_source_manifest_sha256",
        "oracle_request_sha256", "oracle_release_content_binding",
        "oracle_execution_provenance_scope", "verifier_release_content_binding",
        "verifier_execution_provenance_scope", "input_artifact_sha256",
        "independently_rebuilt_ledger", "independently_rebuilt_metrics",
        "producer_result_or_metrics_used", "verified_oracle_metrics",
        "terminal_inventory_mtm_jpy_micros", "external_orders", "anchor_status",
        "reference_engine_id", "reference_code_sha256", "reference_contract_sha256",
        "reference_input_root_sha256", "reference_journal_root_sha256",
        "reference_journal_transaction_count", "reference_all_transactions_balanced",
        "reference_economic_projection_sha256", "reference_result_sha256",
        "reference_accounting_diagnostics_only",
        "reference_n_eff_statistical_admission_allowed",
        "reference_direction_accuracy_profit_gate_allowed", "verifier_receipt_sha256"
      ],
      "type": "object"
    },
    "verifier_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_sha256",
        "receipt_sha256",
        "receipt_size_bytes",
        "verifier_receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_size_bytes": {"type": "integer", "minimum": 0},
        "verifier_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
